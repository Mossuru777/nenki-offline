{
  "name": "nenki-offline-router",
  "main": "router.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "routes": [
    {"pattern": "mossuru777.net/nenki-offline*", "zone_name": "mossuru777.net"}
  ],
  "vars": {
    "PAGES_ORIGIN": "https://nenki-offline.pages.dev"
  }
}
